[Unit]
Description=Crypto Live Trading USDC 7091 (Convert+Spot)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-7091
ExecStart=/opt/crypto-paper-7091/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
