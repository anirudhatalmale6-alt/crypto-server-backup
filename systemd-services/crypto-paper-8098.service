[Unit]
Description=Crypto Paper Trading 8098
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-8098
ExecStart=/opt/crypto-paper-8098/venv/bin/python /opt/crypto-paper-8098/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
