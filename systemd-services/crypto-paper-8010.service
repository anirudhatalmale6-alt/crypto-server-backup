[Unit]
Description=Crypto Paper Trading 8010
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-8010
ExecStart=/opt/crypto-paper-8010/venv/bin/python3 main.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/crypto-paper-8010/crypto-alert.log
StandardError=append:/opt/crypto-paper-8010/crypto-alert.log

[Install]
WantedBy=multi-user.target
