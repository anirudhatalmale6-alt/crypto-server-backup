[Unit]
Description=Crypto Paper Trading 9011 (DEMO - copy of 9000)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-9011
ExecStart=/opt/crypto-paper-9011/venv/bin/python /opt/crypto-paper-9011/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
