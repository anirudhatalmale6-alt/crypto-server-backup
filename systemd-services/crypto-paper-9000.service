[Unit]
Description=Crypto Live Trading 9000 (USDC Volume Pump)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-9000
ExecStart=/opt/crypto-paper-9000/venv/bin/python /opt/crypto-paper-9000/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
