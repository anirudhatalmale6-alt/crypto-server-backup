[Unit]
Description=Crypto Paper Trading 8099
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-8099
ExecStart=/opt/crypto-paper-8099/venv/bin/python /opt/crypto-paper-8099/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
