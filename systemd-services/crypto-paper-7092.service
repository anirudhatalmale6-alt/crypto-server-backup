[Unit]
Description=Crypto Live Trading USDC 7092 (Convert+Spot)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-7092
ExecStart=/opt/crypto-paper-7092/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
