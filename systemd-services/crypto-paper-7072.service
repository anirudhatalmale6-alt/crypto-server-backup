[Unit]
Description=Crypto Paper Trading 7072
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-7072
ExecStart=/opt/crypto-paper-7072/venv/bin/python3 main.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/crypto-paper-7072/crypto-alert.log
StandardError=append:/opt/crypto-paper-7072/crypto-alert.log

[Install]
WantedBy=multi-user.target
