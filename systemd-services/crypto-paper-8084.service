[Unit]
Description=Crypto Paper Trading 8084
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-8084
ExecStart=/opt/crypto-paper-8084/venv/bin/python3 main.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/crypto-paper-8084/crypto-alert.log
StandardError=append:/opt/crypto-paper-8084/crypto-alert.log

[Install]
WantedBy=multi-user.target
