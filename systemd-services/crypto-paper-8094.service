[Unit]
Description=Crypto Paper Trading 8094
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crypto-paper-8094
ExecStart=/opt/crypto-paper-8094/venv/bin/python /opt/crypto-paper-8094/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
