def create_app(config: dict):
    app = Flask(__name__)

    app.secret_key = config.get("dashboard", {}).get("password", "") + "_secret_key_2026"
    dashboard_password = config.get("dashboard", {}).get("password", "")

    @app.route("/login", methods=["GET", "POST"])
    def login():
        error = None
        if request.method == "POST":
            if request.form.get("password") == dashboard_password:
                session["authenticated"] = True
                return redirect("/")
            error = "Wrong password"
        return render_template_string(LOGIN_HTML, error=error)

    @app.route("/logout")
    def logout():
        session.pop("authenticated", None)
        return redirect("/login")

    @app.before_request
    def require_auth():
        if not dashboard_password:
            return
        if request.endpoint in ("login", "forgot_password", "static"):
            return
        if not session.get("authenticated"):
            return redirect("/login")

    security_question = config.get("dashboard", {}).get("security_question", "")
    security_answer = config.get("dashboard", {}).get("security_answer", "")

    @app.route("/forgot", methods=["GET", "POST"])
    def forgot_password():
        error = None
        success = None
        if request.method == "POST":
            answer = request.form.get("answer", "").strip().lower()
            new_pw = request.form.get("new_password", "")
            confirm_pw = request.form.get("confirm_password", "")
            if answer != security_answer.lower():
                error = "Wrong answer"
            elif len(new_pw) < 4:
                error = "Password must be at least 4 characters"
            elif new_pw != confirm_pw:
                error = "Passwords do not match"
            else:
                nonlocal dashboard_password
                dashboard_password = new_pw
                config["dashboard"]["password"] = new_pw
                cfg_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.json")
                try:
                    with open(cfg_path, "w") as cf:
                        import json as _json
                        _json.dump(config, cf, indent=4)
                except Exception:
                    pass
                success = "Password changed successfully!"
                logger.info("Password changed via security question")
        return render_template_string(FORGOT_HTML, question=security_question, error=error, success=success)

    executor = BinanceExecutor(
        api_key=config.get("trading", {}).get("binance_api_key", ""),
        api_secret=config.get("trading", {}).get("binance_api_secret", ""),
        rest_url=config.get("binance", {}).get("rest_url", "https://api.binance.com"),
        api_key_2=config.get("trading", {}).get("binance_api_key_2", ""),
        api_secret_2=config.get("trading", {}).get("binance_api_secret_2", "")
    )

    manager = StealthManager(executor)
    if manager.positions:
        manager.start_monitoring()

    cond_sel = {"active": False, "ids": [], "tp_usdt": None, "tp_book": None, "sl_usdt": None, "sl_book": None, "triggered": None}
    cond_all = {"active": False, "tp_usdt": None, "tp_book": None, "sl_usdt": None, "sl_book": None, "triggered": None}

    @app.route("/")
    def index():
        return render_template_string(DASHBOARD_HTML)

    @app.route("/api/data")
    def api_data():
        data = manager.get_data()
        triggered_list = []
        if cond_sel.get("triggered"):
            triggered_list.append(cond_sel["triggered"]); cond_sel["triggered"] = None
        if cond_all.get("triggered"):
            triggered_list.append(cond_all["triggered"]); cond_all["triggered"] = None

        def _check_cond(rule, positions):
            invested = sum(p["invested_usdt"] for p in positions)
            pnl = sum(p["pnl_usdt"] for p in positions)
            book_pnl = sum(p["book_real_pnl"] for p in positions if p.get("book_avg", 0) > 0)
            if not book_pnl: book_pnl = pnl
            tp = rule.get("tp_usdt")
            if tp and pnl >= tp: return "TP", pnl
            tp_b = rule.get("tp_book")
            if tp_b and book_pnl >= tp_b: return "TP Book", book_pnl
            sl = rule.get("sl_usdt")
            if sl and pnl <= -sl: return "SL", pnl
            sl_b = rule.get("sl_book")
            if sl_b and book_pnl <= -sl_b: return "SL Book", book_pnl
            return None, 0

        if cond_sel.get("active") and data["positions"]:
            sel_ids = set(cond_sel.get("ids", []))
            sel_pos = [p for p in data["positions"] if p["id"] in sel_ids]
            if sel_pos:
                reason, val = _check_cond(cond_sel, sel_pos)
                if reason:
                    closed = 0
                    for p in sel_pos:
                        r = manager.close_position(p["id"])
                        if r: closed += 1
                        logger.info(f"COND SEL {reason}: {p['asset']} closed")
                    cond_sel.update({"active": False, "ids": []})
                    trig = {"mode": "sel", "reason": reason, "value": val, "closed": closed}
                    cond_sel["triggered"] = trig; triggered_list.append(trig)
                    data = manager.get_data()

        if cond_all.get("active") and data["positions"]:
            reason, val = _check_cond(cond_all, data["positions"])
            if reason:
                closed = 0
                for p in data["positions"]:
                    r = manager.close_position(p["id"])
                    if r: closed += 1
                    logger.info(f"COND ALL {reason}: {p['asset']} closed")
                cond_all["active"] = False
                trig = {"mode": "all", "reason": reason, "value": val, "closed": closed}
                cond_all["triggered"] = trig; triggered_list.append(trig)
                data = manager.get_data()

        if triggered_list:
            data["conditional_triggered"] = triggered_list
        return jsonify(data)

    @app.route("/api/position", methods=["POST"])
    def api_add_position():
        data = request.get_json() or {}
        try:
            pos = manager.add_position(
                coin=data["coin"],
                quantity=float(data["quantity"]),
                entry_price=float(data["entry_price"]),
                tp_pct=float(data.get("tp_pct", 0)),
                sl_pct=float(data.get("sl_pct", 0)),
                tp_price=float(data.get("tp_price", 0)),
                sl_price=float(data.get("sl_price", 0)),
                tp_amount=float(data.get("tp_amount", 0)),
                sl_amount=float(data.get("sl_amount", 0)),
                stop_minutes=float(data.get("stop_minutes", 0))
            )
            return jsonify({"status": "ok", "position": pos})
        except Exception as e:
            return jsonify({"error": str(e)}), 400

    @app.route("/api/position/<pid>", methods=["PUT"])
    def api_update_position(pid):
        data = request.get_json() or {}
        try:
            pos = manager.update_position(
                pid,
                tp_pct=data.get("tp_pct"),
                sl_pct=data.get("sl_pct"),
                tp_price=data.get("tp_price"),
                sl_price=data.get("sl_price"),
                tp_amount=data.get("tp_amount"),
                sl_amount=data.get("sl_amount"),
                enabled=data.get("enabled"),
                stop_minutes=data.get("stop_minutes")
            )
            if pos is None:
                return jsonify({"error": "Position not found"}), 404
            return jsonify({"status": "ok", "position": pos})
        except Exception as e:
            return jsonify({"error": str(e)}), 400

    @app.route("/api/position/<pid>", methods=["DELETE"])
    def api_remove_position(pid):
        if manager.remove_position(pid):
            return jsonify({"status": "ok"})
        return jsonify({"error": "Position not found"}), 404

    @app.route("/api/position/<pid>/close", methods=["POST"])
    def api_close_position(pid):
        result = manager.close_position(pid)
        if result is None:
            return jsonify({"error": "Position not found"}), 404
        if isinstance(result, dict) and result.get("error"):
            return jsonify({"error": f"Binance sell failed: {result['error']}"}), 400
        return jsonify({"status": "ok", "closed": result})

    @app.route("/api/close-all", methods=["POST"])
    def api_close_all():
        results = manager.close_all_positions()
        sold = [r for r in results if not (isinstance(r, dict) and r.get("error"))]
        failed = [r for r in results if isinstance(r, dict) and r.get("error")]
        if failed and not sold:
            return jsonify({"error": f"All {len(failed)} sells failed", "details": failed}), 400
        msg = f"{len(sold)} sold on Binance"
        if failed:
            msg += f", {len(failed)} failed"
        return jsonify({"status": "ok", "closed": len(sold), "failed": len(failed), "message": msg})

    @app.route("/api/close-selected", methods=["POST"])
    def api_close_selected():
        data = request.get_json() or {}
        ids = data.get("ids", [])
        if not ids:
            return jsonify({"error": "No positions selected"}), 400
        closed = 0
        failed = 0
        for pid in ids:
            r = manager.close_position(pid)
            if r and isinstance(r, dict) and r.get("error"):
                failed += 1
            elif r:
                closed += 1
        if failed and not closed:
            return jsonify({"error": f"All {failed} sells failed on Binance"}), 400
        msg = f"{closed} closed"
        if failed:
            msg += f", {failed} failed"
        return jsonify({"status": "ok", "closed": closed, "failed": failed, "message": msg})

    @app.route("/api/conditional-close/sel", methods=["POST"])
    def set_cond_sel():
        data = request.get_json() or {}
        ids = data.get("ids", [])
        if not ids: return jsonify({"success": False, "error": "No positions"}), 400
        cond_sel.update({"active": True, "ids": ids, "tp_usdt": data.get("tp_usdt"), "tp_book": data.get("tp_book"), "sl_usdt": data.get("sl_usdt"), "sl_book": data.get("sl_book"), "triggered": None})
        logger.info(f"COND SEL SET: {len(ids)} pos")
        return jsonify({"success": True, "count": len(ids)})

    @app.route("/api/conditional-close/sel", methods=["DELETE"])
    def clear_cond_sel():
        cond_sel.update({"active": False, "ids": [], "tp_usdt": None, "tp_book": None, "sl_usdt": None, "sl_book": None, "triggered": None})
        return jsonify({"success": True})

    @app.route("/api/conditional-close/all", methods=["POST"])
    def set_cond_all():
        data = request.get_json() or {}
        cond_all.update({"active": True, "tp_usdt": data.get("tp_usdt"), "tp_book": data.get("tp_book"), "sl_usdt": data.get("sl_usdt"), "sl_book": data.get("sl_book"), "triggered": None})
        logger.info("COND ALL SET")
        return jsonify({"success": True})

    @app.route("/api/conditional-close/all", methods=["DELETE"])
    def clear_cond_all():
        cond_all.update({"active": False, "tp_usdt": None, "tp_book": None, "sl_usdt": None, "sl_book": None, "triggered": None})
