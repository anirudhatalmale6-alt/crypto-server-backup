class BinanceExecutor:
    """Only used for executing sell orders. No monitoring, no account reading."""

    def __init__(self, api_key: str, api_secret: str, rest_url: str = "https://api.binance.com",
                 api_key_2: str = "", api_secret_2: str = ""):
        self.api_keys = [(api_key, api_secret)]
        if api_key_2 and api_secret_2:
            self.api_keys.append((api_key_2, api_secret_2))
        self.active_key_idx = 0
        self.api_key = api_key
        self.api_secret = api_secret
        self.rest_url = rest_url
        self._exchange_info_cache = {}
        self._usdc_pairs = None

    def _sign(self, params: dict) -> dict:
        params["timestamp"] = int(time.time() * 1000)
        query_string = urlencode(params)
        signature = hmac.new(
            self.api_secret.encode(), query_string.encode(), hashlib.sha256
        ).hexdigest()
        params["signature"] = signature
        return params

    def _headers(self):
        return {"X-MBX-APIKEY": self.api_key}

    def _switch_api_key(self) -> bool:
        if len(self.api_keys) <= 1:
            return False
        next_idx = (self.active_key_idx + 1) % len(self.api_keys)
        if next_idx == getattr(self, '_first_quota_key', -1):
            logger.error(f"All {len(self.api_keys)} API keys have hit quota limit")
            return False
        if not hasattr(self, '_first_quota_key') or self._first_quota_key == -1:
            self._first_quota_key = self.active_key_idx
        self.active_key_idx = next_idx
        self.api_key, self.api_secret = self.api_keys[self.active_key_idx]
        logger.info(f"SWITCHED to API key #{self.active_key_idx + 1}")
        return True

    def _reset_quota_tracking(self):
        self._first_quota_key = -1

    def _adjust_quantity(self, symbol: str, quantity: float):
        if symbol not in self._exchange_info_cache:
            try:
                resp = requests.get(f"{self.rest_url}/api/v3/exchangeInfo",
                                    params={"symbol": symbol}, timeout=10)
                resp.raise_for_status()
                for s in resp.json().get("symbols", []):
                    if s["symbol"] == symbol:
                        self._exchange_info_cache[symbol] = s
                        break
            except Exception as e:
                logger.error(f"exchangeInfo failed: {e}")
                return quantity

        info = self._exchange_info_cache.get(symbol)
        if not info:
            return quantity

        for f in info.get("filters", []):
            if f["filterType"] == "LOT_SIZE":
                step_size = float(f["stepSize"])
                min_qty = float(f["minQty"])
                if step_size > 0:
                    precision = len(f["stepSize"].rstrip("0").split(".")[-1]) if "." in f["stepSize"] else 0
                    adjusted = round(quantity - (quantity % step_size), precision)
                    if adjusted < min_qty:
                        return None
                    return adjusted
        return quantity

    def get_balance(self, asset: str):
        try:
            params = self._sign({})
            resp = requests.get(
                f"{self.rest_url}/api/v3/account",
                params=params, headers=self._headers(), timeout=10
            )
            resp.raise_for_status()
            for b in resp.json().get("balances", []):
                if b["asset"] == asset:
                    return float(b["free"])
            return 0.0
        except Exception as e:
            logger.error(f"Balance check failed for {asset}: {e}")
            return None

    MAX_CONVERT_EUR = 195.0
    MIN_CONVERT_EUR = 5.0

    def _single_convert(self, from_asset: str, to_asset: str, quantity: float):
        """Execute a single Convert API call (getQuote + acceptQuote)."""
        if from_asset == "EUR":
            amount_str = f"{quantity:.2f}"
        else:
            amount_str = f"{quantity:.8f}".rstrip("0").rstrip(".")

        logger.info(f"CONVERT: {amount_str} {from_asset} -> {to_asset}")
        try:
            params = self._sign({
                "fromAsset": from_asset,
                "toAsset": to_asset,
                "fromAmount": amount_str,
            })
            resp = requests.post(
                f"{self.rest_url}/sapi/v1/convert/getQuote",
                params=params, headers=self._headers(), timeout=10
            )
            if resp.status_code != 200:
                err = resp.json() if resp.headers.get("content-type", "").startswith("application/json") else {"msg": resp.text}
                if err.get("code") == 345239 or "quotation limit" in str(err.get("msg", "")).lower():
                    logger.warning(f"CONVERT: Daily quota limit hit on key #{self.active_key_idx + 1}")
                    if self._switch_api_key():
                        logger.info(f"Retrying with key #{self.active_key_idx + 1}")
                        return self._single_convert(from_asset, to_asset, quantity)
                    logger.error(f"CONVERT: All API keys exhausted quota")
                logger.error(f"CONVERT QUOTE FAILED: {from_asset}->{to_asset} - {err}")
                return {"error": f"Convert quote failed: {err.get('msg', err)}"}
            quote = resp.json()
            quote_id = quote.get("quoteId")
            ratio = float(quote.get("ratio", 0))
            to_amount = float(quote.get("toAmount", 0))
            from_amount = float(quote.get("fromAmount", quantity))
            logger.info(f"CONVERT QUOTE: {amount_str} {from_asset} -> {to_amount:.4f} {to_asset} (rate {ratio:.10g})")

            if not quote_id:
                logger.error(f"CONVERT: No quoteId for {amount_str} {from_asset}->{to_asset}. Response: {quote}")
                return {"error": "No quoteId - amount may exceed Convert limit"}

            params2 = self._sign({"quoteId": quote_id})
            resp2 = requests.post(
                f"{self.rest_url}/sapi/v1/convert/acceptQuote",
                params=params2, headers=self._headers(), timeout=10
            )
            if resp2.status_code != 200:
                err2 = resp2.json() if resp2.headers.get("content-type", "").startswith("application/json") else {"msg": resp2.text}
                logger.error(f"CONVERT ACCEPT FAILED: {from_asset}->{to_asset} - {err2}")
                return {"error": f"Convert accept failed: {err2.get('msg', err2)}"}
            result = resp2.json()
            logger.info(f"CONVERT FILLED: {from_amount} {from_asset} -> {to_amount:.4f} {to_asset}")
            return {
                "order_id": result.get("orderId", quote_id),
                "from_amount": from_amount,
                "to_amount": to_amount,
                "ratio": ratio,
                "status": "FILLED",
            }
        except Exception as e:
            logger.error(f"CONVERT FAILED: {from_asset}->{to_asset} - {e}")
            return None

    def _convert(self, from_asset: str, to_asset: str, quantity: float):
        """Convert with automatic chunking for amounts exceeding EUR limit."""
        if from_asset == "EUR":
            estimated_eur = quantity
        elif to_asset == "EUR":
            try:
                symbol = from_asset + "USDT"
                resp = requests.get(f"{self.rest_url}/api/v3/ticker/price",
                                    params={"symbol": symbol}, timeout=10)
                resp.raise_for_status()
                usdt_price = float(resp.json()["price"])
                eur_resp = requests.get(f"{self.rest_url}/api/v3/ticker/price",
                                        params={"symbol": "EURUSDT"}, timeout=10)
                eur_resp.raise_for_status()
                eur_rate = float(eur_resp.json()["price"])
                estimated_eur = quantity * usdt_price / eur_rate
            except Exception:
                estimated_eur = self.MAX_CONVERT_EUR + 100
        else:
            estimated_eur = self.MAX_CONVERT_EUR + 100

        if estimated_eur <= self.MAX_CONVERT_EUR * 1.2:
            result = self._single_convert(from_asset, to_asset, quantity)
            if result is None or result.get("error"):
                return result
            return {
                "order_id": result["order_id"],
                "filled_qty": result["from_amount"],
                "filled_quote": result["to_amount"],
                "avg_price": result.get("ratio", 0),
                "status": "FILLED",
                "method": "CONVERT",
                "to_asset": to_asset
            }

        if from_asset == "EUR":
            if quantity > self.MAX_CONVERT_EUR:
                logger.info(f"BUY: trying full {quantity:.2f} EUR -> {to_asset} in one call")
                full_result = self._single_convert(from_asset, to_asset, quantity)
                if full_result is not None and not full_result.get("error"):
                    logger.info(f"CONVERT COMPLETE: {quantity:.2f} EUR -> {full_result['to_amount']:.4f} {to_asset} (1 call)")
                    return {
                        "order_id": full_result["order_id"],
                        "filled_qty": full_result["from_amount"],
                        "filled_quote": full_result["to_amount"],
                        "avg_price": full_result.get("ratio", 0),
                        "status": "FILLED",
                        "method": "CONVERT",
                        "to_asset": to_asset
                    }
                logger.info(f"Full amount failed, falling back to chunking at {self.MAX_CONVERT_EUR} EUR")
            chunks_amount = []
            remaining = quantity
            while remaining >= self.MIN_CONVERT_EUR:
                chunk = min(remaining, self.MAX_CONVERT_EUR)
                chunks_amount.append(round(chunk, 2))
                remaining -= chunk
        else:
            coins_per_chunk = (self.MAX_CONVERT_EUR / estimated_eur) * quantity * 0.95
            chunks_amount = []
            remaining = quantity
            while remaining > 0:
                chunk = min(remaining, coins_per_chunk)
                chunks_amount.append(chunk)
                remaining -= chunk
                if remaining < coins_per_chunk * 0.1:
                    if remaining > 0:
                        chunks_amount[-1] += remaining
                    break

        logger.info(f"CONVERT CHUNKED: {len(chunks_amount)} chunks for {quantity} {from_asset} -> {to_asset}")

        total_from = 0.0
        total_to = 0.0
        last_order_id = None
        last_ratio = 0

        for i, chunk_amt in enumerate(chunks_amount):
            logger.info(f"CONVERT chunk {i+1}/{len(chunks_amount)}: {chunk_amt} {from_asset}")
            result = None
            for attempt in range(3):
                result = self._single_convert(from_asset, to_asset, chunk_amt)
                if result is not None and not result.get("error"):
                    break
                if attempt < 2:
                    logger.info(f"CONVERT chunk {i+1}: retry {attempt+2}/3 in 2s...")
                    import time as _time
                    _time.sleep(2)

            if result is None or result.get("error"):
                if total_from > 0:
                    logger.warning(f"Partial convert: {total_from} {from_asset} -> {total_to} {to_asset} ({i}/{len(chunks_amount)} chunks)")
                    break
                return result

            total_from += result["from_amount"]
            total_to += result["to_amount"]
            last_order_id = result["order_id"]
            last_ratio = result.get("ratio", 0)

            if i < len(chunks_amount) - 1:
                time.sleep(0.3)

        logger.info(f"CONVERT COMPLETE: {total_from} {from_asset} -> {total_to} {to_asset} ({len(chunks_amount)} chunks)")

        return {
            "order_id": last_order_id,
            "filled_qty": total_from,
            "filled_quote": total_to,
            "avg_price": last_ratio,
            "status": "FILLED",
            "method": "CONVERT",
            "to_asset": to_asset
        }

    def _adjust_quantity(self, symbol: str, quantity: float):
        try:
            resp = requests.get(
                f"{self.rest_url}/api/v3/exchangeInfo",
                params={"symbol": symbol}, timeout=10
            )
            resp.raise_for_status()
            for s in resp.json().get("symbols", []):
                if s["symbol"] == symbol:
                    for f in s.get("filters", []):
                        if f["filterType"] == "LOT_SIZE":
                            step_size = float(f["stepSize"])
                            min_qty = float(f["minQty"])
                            if step_size > 0:
                                precision = len(f["stepSize"].rstrip("0").split(".")[-1]) if "." in f["stepSize"] else 0
                                adjusted = round(quantity - (quantity % step_size), precision)
                                if adjusted < min_qty:
                                    return None
                                return adjusted
        except Exception as e:
            logger.error(f"exchangeInfo failed for {symbol}: {e}")
        return quantity

    def _spot_sell_usdc(self, symbol: str, quantity: float):
        usdc_symbol = symbol.replace("USDT", "USDC")
        adjusted = self._adjust_quantity(usdc_symbol, quantity)
        if adjusted is None:
            logger.error(f"Cannot adjust quantity for {usdc_symbol}")
            return {"error": f"Quantity too small for {usdc_symbol}"}

        logger.info(f"USDC SPOT SELL: {adjusted} {usdc_symbol}")
        try:
            params = self._sign({
                "symbol": usdc_symbol,
                "side": "SELL",
                "type": "MARKET",
                "quantity": f"{adjusted}",
            })
            resp = requests.post(
                f"{self.rest_url}/api/v3/order",
                params=params, headers=self._headers(), timeout=10
            )
            if resp.status_code != 200:
                err = resp.json() if resp.headers.get("content-type", "").startswith("application/json") else {"msg": resp.text}
                logger.error(f"USDC SPOT SELL FAILED: {usdc_symbol} - {err}")
                return {"error": f"USDC spot sell failed: {err.get('msg', err)}"}
            order = resp.json()

            filled_qty = float(order.get("executedQty", 0))
            filled_quote = float(order.get("cummulativeQuoteQty", 0))
            avg_price = filled_quote / filled_qty if filled_qty > 0 else 0

            logger.info(f"USDC SPOT SELL FILLED: {filled_qty} {usdc_symbol} @ {avg_price:.8g} for {filled_quote:.2f} USDC")
            return {
                "order_id": order.get("orderId"),
                "filled_qty": filled_qty,
                "filled_quote": filled_quote,
                "avg_price": avg_price,
                "status": "FILLED",
                "method": "SPOT_USDC",
                "to_asset": "USDC",
            }
        except Exception as e:
            logger.error(f"USDC SPOT SELL exception: {usdc_symbol} - {e}")
            return None

    def market_sell(self, symbol: str, quantity: float):
        asset = symbol.replace("USDT", "").replace("USDC", "")
        if quantity <= 0:
            logger.error(f"No {asset} available to sell")
            return None

        result = self._convert(asset, "EUR", quantity)
        if result is not None and not result.get("error"):
            return result

        logger.info(f"Convert sell failed for {asset}, trying USDC spot fallback")
        usdc_result = self._spot_sell_usdc(symbol, quantity)
        if usdc_result is not None and not usdc_result.get("error"):
            return usdc_result

        if usdc_result and usdc_result.get("error"):
            return usdc_result
        return result

    def market_buy(self, asset: str, eur_amount: float):
        if eur_amount <= 0:
            logger.error(f"Invalid EUR amount: {eur_amount}")
            return None

        return self._convert("EUR", asset, eur_amount)

    def estimate_sell(self, symbol: str, quantity: float):
        """Analyze order book to estimate fill price and slippage for a market sell."""
        try:
            resp = requests.get(f"{self.rest_url}/api/v3/depth",
                                params={"symbol": symbol, "limit": 50}, timeout=10)
            resp.raise_for_status()
            book = resp.json()
            bids = book.get("bids", [])

            best_bid = float(bids[0][0]) if bids else 0
            remaining = quantity
            total_quote = 0.0
            levels_used = 0

            for price_str, qty_str in bids:
                price = float(price_str)
                qty = float(qty_str)
                fill = min(remaining, qty)
                total_quote += fill * price
                remaining -= fill
                levels_used += 1
                if remaining <= 0:
                    break

            if remaining > 0:
                return None

            expected_avg = total_quote / quantity if quantity > 0 else 0
            slippage_pct = ((best_bid - expected_avg) / best_bid * 100) if best_bid > 0 else 0

            return {
                "best_bid": best_bid,
                "expected_avg_price": round(expected_avg, 10),
                "expected_quote": round(total_quote, 4),
                "slippage_pct": round(slippage_pct, 4),
                "book_levels_used": levels_used,
                "book_depth": len(bids)
            }
        except Exception as e:
            logger.error(f"Order book fetch failed: {e}")
            return None


class StealthManager:
    """Manual positions + public WebSocket price monitoring + hidden TP/SL."""

    def __init__(self, executor: BinanceExecutor):
        self.executor = executor
        self.positions = {}   # id -> position dict
        self.prices = {}      # symbol -> current price
        self.book_prices = {} # symbol -> {avg_price, levels, best_bid, quote_total}
        self.closed = []
        self._lock = threading.Lock()
        self._ws_thread = None
        self._book_thread = None
        self._ws = None
        self._running = False
        self.ws_connected = False
        self._pos_file = os.path.join(DATA_DIR, "stealth_positions.json")
        self._closed_file = os.path.join(DATA_DIR, "stealth_closed.json")
        self._load()

    def _load(self):
        try:
            with open(self._pos_file, "r") as f:
                self.positions = json.load(f)
            logger.info(f"Loaded {len(self.positions)} manual positions")
        except (FileNotFoundError, json.JSONDecodeError):
            self.positions = {}
        try:
            with open(self._closed_file, "r") as f:
                self.closed = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.closed = []

    def _save_positions(self):
        with open(self._pos_file, "w") as f:
            json.dump(self.positions, f, indent=2)

    def _save_closed(self):
        with open(self._closed_file, "w") as f:
            json.dump(self.closed, f, indent=2)

    def add_position(self, coin: str, quantity: float, entry_price: float,
                     tp_pct: float = 0, sl_pct: float = 0,
                     tp_price: float = 0, sl_price: float = 0,
                     tp_amount: float = 0, sl_amount: float = 0,
                     stop_minutes: float = 0):
        """Add a manual position."""
        symbol = coin.upper().replace("USDT", "") + "USDT"
        asset = coin.upper().replace("USDT", "")
        pid = f"{symbol}_{int(time.time())}"
        invested = entry_price * quantity

        # Capture EURUSDT rate at entry for accurate EUR PnL
        eur_rate = 0
        try:
            r = requests.get("https://api.binance.com/api/v3/ticker/price", params={"symbol": "EURUSDT"}, timeout=5)
            if r.status_code == 200:
                eur_rate = float(r.json().get("price", 0))
        except Exception:
            pass
        invested_eur = round(invested / eur_rate, 2) if eur_rate > 0 else 0

        pos = {
            "id": pid,
            "symbol": symbol,
            "asset": asset,
            "quantity": quantity,
            "entry_price": entry_price,
            "invested_usdt": invested,
            "invested_eur": invested_eur,
            "entry_eur_rate": eur_rate,
            "tp_pct": tp_pct,
            "sl_pct": sl_pct,
            "tp_price": tp_price if tp_price > 0 else (entry_price * (1 + tp_pct / 100) if tp_pct > 0 else 0),
            "sl_price": sl_price if sl_price > 0 else (entry_price * (1 - sl_pct / 100) if sl_pct > 0 else 0),
            "tp_amount": tp_amount,
            "sl_amount": sl_amount,
            "enabled": True,
            "stop_minutes": stop_minutes,
            "created": datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S")
        }

        # Compute from amounts if provided
        if tp_amount > 0 and invested > 0:
            pos["tp_pct"] = (tp_amount / invested) * 100
            pos["tp_price"] = entry_price * (1 + pos["tp_pct"] / 100)
        if sl_amount > 0 and invested > 0:
            pos["sl_pct"] = (sl_amount / invested) * 100
            pos["sl_price"] = entry_price * (1 - pos["sl_pct"] / 100)

        self.positions[pid] = pos
        self._save_positions()
        logger.info(f"Added position {pid}: {symbol} qty={quantity} entry={entry_price} TP={pos['tp_price']:.8g} SL={pos['sl_price']:.8g}")
        self._restart_ws()
        return pos

    def update_position(self, pid: str, tp_pct=None, sl_pct=None,
                        tp_price=None, sl_price=None,
                        tp_amount=None, sl_amount=None, enabled=None,
                        stop_minutes=None):
        """Update TP/SL for an existing position."""
        pos = self.positions.get(pid)
        if not pos:
            return None

        entry = pos["entry_price"]
        invested = pos.get("invested_usdt", entry * pos["quantity"])

        if tp_pct is not None and tp_pct > 0:
            pos["tp_pct"] = tp_pct
            pos["tp_price"] = entry * (1 + tp_pct / 100)
            pos["tp_amount"] = invested * tp_pct / 100
        elif tp_amount is not None and tp_amount > 0 and invested > 0:
            pos["tp_amount"] = tp_amount
            pos["tp_pct"] = (tp_amount / invested) * 100
            pos["tp_price"] = entry * (1 + pos["tp_pct"] / 100)
        elif tp_price is not None and tp_price > 0:
            pos["tp_price"] = tp_price
            pos["tp_pct"] = ((tp_price - entry) / entry * 100) if entry > 0 else 0
            pos["tp_amount"] = invested * pos["tp_pct"] / 100

        if sl_pct is not None and sl_pct > 0:
            pos["sl_pct"] = sl_pct
            pos["sl_price"] = entry * (1 - sl_pct / 100)
            pos["sl_amount"] = invested * sl_pct / 100
        elif sl_amount is not None and sl_amount > 0 and invested > 0:
            pos["sl_amount"] = sl_amount
            pos["sl_pct"] = (sl_amount / invested) * 100
            pos["sl_price"] = entry * (1 - pos["sl_pct"] / 100)
        elif sl_price is not None and sl_price > 0:
            pos["sl_price"] = sl_price
            pos["sl_pct"] = ((entry - sl_price) / entry * 100) if entry > 0 else 0
            pos["sl_amount"] = invested * pos["sl_pct"] / 100

        if enabled is not None:
            pos["enabled"] = enabled
        if stop_minutes is not None:
            pos["stop_minutes"] = stop_minutes

        self.positions[pid] = pos
        self._save_positions()
        return pos

    def remove_position(self, pid: str):
        if pid in self.positions:
            del self.positions[pid]
            self._save_positions()
            self._restart_ws()
            return True
        return False

    def close_position(self, pid: str):
        """Execute market sell and close the position."""
        pos = self.positions.get(pid)
        if not pos:
            return None

        symbol = pos["symbol"]
        qty = pos["quantity"]
        usdt_price = self.prices.get(symbol, 0)

        estimate = self.executor.estimate_sell(symbol, qty)

        result = self.executor.market_sell(symbol, qty)

        if result is None:
            logger.error(f"CLOSE FAILED - position kept: {symbol} - sell returned None (exception or no balance)")
            return {"error": "Sell failed - no response from Binance"}

        if result.get("error"):
            logger.error(f"CLOSE FAILED - position kept: {symbol} - {result['error']}")
            return {"error": result["error"]}

        # PnL uses USDT price (entry is USDT-denominated)
        exit_price_usdt = usdt_price
        entry = pos["entry_price"]
        value_usdt = qty * exit_price_usdt if exit_price_usdt > 0 else pos.get("invested_usdt", 0)
        pnl_pct = ((exit_price_usdt - entry) / entry * 100) if entry > 0 and exit_price_usdt > 0 else 0

        # EUR received from Convert
        eur_received = result.get("filled_quote", 0)

        # EUR PnL: exit EUR - invested EUR (using entry-time EUR rate)
        invested_eur = pos.get("invested_eur", 0)
        if invested_eur <= 0 and pos.get("entry_eur_rate", 0) > 0:
            invested_eur = pos.get("invested_usdt", 0) / pos["entry_eur_rate"]
        pnl_eur = round(eur_received - invested_eur, 2) if invested_eur > 0 else 0

        slippage = {}
        if estimate and usdt_price > 0:
            slippage = {
                "best_bid": estimate["best_bid"],
                "expected_avg": estimate["expected_avg_price"],
                "actual_usdt": usdt_price,
                "slippage_vs_best": round((estimate["best_bid"] - usdt_price) / estimate["best_bid"] * 100, 4) if estimate["best_bid"] > 0 else 0,
                "book_levels_used": estimate["book_levels_used"],
            }

        closed = {
            "id": pid,
            "symbol": symbol,
            "asset": pos["asset"],
            "quantity": qty,
            "entry_price": entry,
            "exit_price": exit_price_usdt,
            "invested_usdt": pos.get("invested_usdt", 0),
            "invested_eur": round(invested_eur, 2),
            "exit_value_usdt": round(value_usdt, 2),
            "exit_value_eur": round(eur_received, 2),
            "pnl_pct": round(pnl_pct, 2),
            "pnl_usdt": round(value_usdt - pos.get("invested_usdt", 0), 2),
            "pnl_eur": pnl_eur,
            "exit_reason": "MANUAL",
            "exit_time": datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S"),
            "order": result,
            "slippage": slippage
        }
        self.closed.append(closed)
        self._save_closed()

        with self._lock:
            if pid in self.positions:
                del self.positions[pid]
                self._save_positions()

        logger.info(f"MANUAL CLOSE: {symbol} @ {exit_price_usdt:.8g} USDT, received {eur_received:.2f} EUR (invested {invested_eur:.2f} EUR), PnL EUR={pnl_eur:+.2f}")
        return closed

    def close_all_positions(self):
        """Close all open positions via market sell."""
        results = []
        pids = list(self.positions.keys())
        for pid in pids:
            result = self.close_position(pid)
            if result:
                results.append(result)
        return results

    def _check_tp_sl(self, symbol: str, price: float):
        """Check all positions for this symbol."""
        to_close = []
        with self._lock:
            for pid, pos in list(self.positions.items()):
                if pos["symbol"] != symbol or not pos.get("enabled"):
                    continue

                tp = pos.get("tp_price", 0)
                sl = pos.get("sl_price", 0)
                reason = None

                if tp > 0 and price >= tp:
                    reason = "TP"
                elif sl > 0 and price <= sl:
                    reason = "SL"

                stop_min = pos.get("stop_minutes", 0)
                if not reason and stop_min > 0:
                    created = datetime.strptime(pos.get("created", ""), "%Y-%m-%d %H:%M:%S")
                    elapsed = (datetime.utcnow() - created).total_seconds() / 60.0
                    if elapsed >= stop_min:
                        reason = "TIME"

                if reason:
                    to_close.append((pid, pos, reason, price))

        for pid, pos, reason, price in to_close:
            logger.info(f"{reason} HIT: {pos['symbol']} @ {price:.8g} (TP={pos.get('tp_price',0):.8g}, SL={pos.get('sl_price',0):.8g})")
            result = self.executor.market_sell(pos["symbol"], pos["quantity"])

            if result is None or (isinstance(result, dict) and result.get("error")):
                err_msg = result.get("error", "Unknown") if result else "No response"
                logger.error(f"{reason} CLOSE FAILED - position kept: {pos['symbol']} - {err_msg}")
                continue

            entry = pos["entry_price"]
            pnl_pct = ((price - entry) / entry * 100) if entry > 0 else 0
            value = pos["quantity"] * price

            eur_received = result.get("filled_quote", 0)
            invested_eur = pos.get("invested_eur", 0)
            if invested_eur <= 0 and pos.get("entry_eur_rate", 0) > 0:
                invested_eur = pos.get("invested_usdt", 0) / pos["entry_eur_rate"]
            pnl_eur = round(eur_received - invested_eur, 2) if invested_eur > 0 else 0

            closed = {
                "id": pid,
                "symbol": pos["symbol"],
                "asset": pos["asset"],
                "quantity": pos["quantity"],
                "entry_price": entry,
                "exit_price": price,
                "invested_usdt": pos.get("invested_usdt", 0),
                "invested_eur": round(invested_eur, 2),
                "exit_value_usdt": round(value, 2),
                "exit_value_eur": round(eur_received, 2),
                "pnl_pct": round(pnl_pct, 2),
                "pnl_usdt": round(value - pos.get("invested_usdt", 0), 2),
                "pnl_eur": pnl_eur,
                "exit_reason": reason,
                "exit_time": datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S"),
                "order": result
            }
            self.closed.append(closed)
            self._save_closed()

            with self._lock:
                if pid in self.positions:
                    del self.positions[pid]
                    self._save_positions()

            logger.info(f"CLOSED {pos['symbol']}: {reason} @ {price:.8g}, PnL={pnl_pct:+.2f}%")

    def _process_ticker(self, item):
        symbol = item.get("s", "")
        price = float(item.get("c", 0))
        if symbol and price > 0:
            self.prices[symbol] = price
            self._check_tp_sl(symbol, price)

    def _on_ws_message(self, ws, message):
        try:
            data = json.loads(message)
            if "data" in data:
                inner = data["data"]
                if isinstance(inner, list):
                    for item in inner:
                        self._process_ticker(item)
                else:
                    self._process_ticker(inner)
            elif isinstance(data, list):
                for item in data:
                    self._process_ticker(item)
            elif "s" in data:
                self._process_ticker(data)
        except Exception as e:
            logger.error(f"WS error: {e}")

    def _on_ws_open(self, ws):
        self.ws_connected = True
        logger.info("Public WebSocket connected (no API key used)")

    def _on_ws_error(self, ws, error):
        logger.error(f"WS error: {error}")
        self.ws_connected = False

    def _on_ws_close(self, ws, code, msg):
        self.ws_connected = False
        if self._running:
            time.sleep(5)
            self._connect_ws()

    def _connect_ws(self):
        symbols = set()
        for pos in self.positions.values():
            symbols.add(pos["symbol"].lower())
        if not symbols:
            logger.info("No positions to monitor")
            return

        symbols.add("eurusdt")
        streams = [f"{s}@miniTicker" for s in symbols]
        url = f"wss://stream.binance.com:9443/stream?streams={'/'.join(streams)}"
        logger.info(f"Connecting public WebSocket for {len(symbols)} symbols (NO API key)...")

        self._ws = websocket.WebSocketApp(
            url,
            on_message=lambda ws, msg: self._on_ws_message(ws, msg),
            on_error=lambda ws, err: self._on_ws_error(ws, err),
            on_close=lambda ws, code, msg: self._on_ws_close(ws, code, msg),
            on_open=lambda ws: self._on_ws_open(ws)
        )
        self._ws.run_forever()

    def _restart_ws(self):
        if self._ws:
            try:
                self._ws.close()
            except Exception:
                pass
        self.start_monitoring()

    def _book_loop(self):
        """Periodically fetch order book for each position to calculate real fill prices."""
        while self._running:
            symbols_qty = {}
            for pos in list(self.positions.values()):
                sym = pos["symbol"]
                qty = pos["quantity"]
                if sym in symbols_qty:
                    symbols_qty[sym] += qty
                else:
                    symbols_qty[sym] = qty

            for symbol, qty in symbols_qty.items():
                est = self.executor.estimate_sell(symbol, qty)
                if est:
                    self.book_prices[symbol] = {
                        "avg_price": est["expected_avg_price"],
                        "best_bid": est["best_bid"],
                        "levels": est["book_levels_used"],
                        "quote_total": est["expected_quote"],
                        "slippage_pct": est["slippage_pct"]
                    }
                time.sleep(0.5)
            time.sleep(10)

    def start_monitoring(self):
        if self._ws_thread and self._ws_thread.is_alive():
            return
        self._running = True
        self._ws_thread = threading.Thread(target=self._connect_ws, daemon=True)
        self._ws_thread.start()
        if not self._book_thread or not self._book_thread.is_alive():
            self._book_thread = threading.Thread(target=self._book_loop, daemon=True)
            self._book_thread.start()

    def get_data(self):
        positions_list = []
        total_invested = 0
        total_value = 0

        for pid, pos in list(self.positions.items()):
            current = self.prices.get(pos["symbol"], 0)
            entry = pos["entry_price"]
            qty = pos["quantity"]
            invested = pos.get("invested_usdt", entry * qty)
            value = qty * current if current > 0 else invested
            pnl_pct = ((current - entry) / entry * 100) if entry > 0 and current > 0 else 0
            pnl_usdt = value - invested

            book = self.book_prices.get(pos["symbol"], {})
            book_avg = book.get("avg_price", 0)
            book_value = qty * book_avg if book_avg > 0 else 0
            book_pnl_usdt = book_value - invested if book_avg > 0 else 0
            book_pnl_pct = ((book_avg - entry) / entry * 100) if entry > 0 and book_avg > 0 else 0
            book_after_fee = book_value * 0.999 if book_avg > 0 else 0
            book_real_pnl = book_after_fee - invested if book_avg > 0 else 0

            total_invested += invested
            total_value += value

            positions_list.append({
                "id": pid,
                "symbol": pos["symbol"],
                "asset": pos["asset"],
                "quantity": qty,
                "entry_price": entry,
                "current_price": current,
                "invested_usdt": round(invested, 2),
                "invested_eur": pos.get("invested_eur", 0),
                "entry_eur_rate": pos.get("entry_eur_rate", 0),
                "value_usdt": round(value, 2),
                "pnl_pct": round(pnl_pct, 2),
                "pnl_usdt": round(pnl_usdt, 2),
                "tp_pct": pos.get("tp_pct", 0),
                "sl_pct": pos.get("sl_pct", 0),
                "tp_price": pos.get("tp_price", 0),
                "sl_price": pos.get("sl_price", 0),
                "tp_amount": pos.get("tp_amount", 0),
                "sl_amount": pos.get("sl_amount", 0),
                "enabled": pos.get("enabled", False),
                "stop_minutes": pos.get("stop_minutes", 0),
                "created": pos.get("created", ""),
                "book_avg": round(book_avg, 10),
                "book_best_bid": book.get("best_bid", 0),
                "book_levels": book.get("levels", 0),
                "book_slippage": book.get("slippage_pct", 0),
                "book_value": round(book_value, 2),
                "book_real_pnl": round(book_real_pnl, 2),
                "book_real_pnl_pct": round(((book_after_fee - invested) / invested * 100) if invested > 0 and book_avg > 0 else 0, 2)
            })

        positions_list.sort(key=lambda x: abs(x["value_usdt"]), reverse=True)

        total_book_pnl = sum(p["book_real_pnl"] for p in positions_list if p["book_avg"] > 0)
        eur_rate = self.prices.get("EURUSDT", 0)

        return {
            "positions": positions_list,
            "closed": self.closed[-50:],
            "total_positions": len(positions_list),
            "total_invested": round(total_invested, 2),
            "total_value": round(total_value, 2),
            "total_pnl": round(total_value - total_invested, 2),
            "total_book_pnl": round(total_book_pnl, 2),
            "ws_connected": self.ws_connected,
            "eur_rate": round(eur_rate, 5)
        }


