                <span style="color:#c9d1d9;font-size:13px;font-weight:700;margin-right:4px;">CLOSE SELECTED WHEN</span>
                <div style="display:flex;align-items:center;gap:4px;">
                    <label style="color:#8b949e;font-size:12px;white-space:nowrap;">TP USDT</label>
                    <input id="condSelTp" type="number" step="0.01" min="0" style="width:70px;padding:4px 6px;background:#0d1117;border:1px solid #30363d;color:#c9d1d9;border-radius:4px;font-size:12px;" placeholder="0">
                    <span id="condSelTpEur" style="color:#8b949e;font-size:11px;"></span>
                </div>
                <div style="display:flex;align-items:center;gap:4px;">
                    <label style="color:#8b949e;font-size:12px;white-space:nowrap;">TP Book USDT</label>
                    <input id="condSelTpBook" type="number" step="0.01" min="0" style="width:70px;padding:4px 6px;background:#0d1117;border:1px solid #30363d;color:#c9d1d9;border-radius:4px;font-size:12px;" placeholder="0">
                    <span id="condSelTpBookEur" style="color:#8b949e;font-size:11px;"></span>
                </div>
                <div style="display:flex;align-items:center;gap:4px;">
                    <label style="color:#8b949e;font-size:12px;white-space:nowrap;">SL USDT</label>
                    <input id="condSelSl" type="number" step="0.01" min="0" style="width:70px;padding:4px 6px;background:#0d1117;border:1px solid #30363d;color:#c9d1d9;border-radius:4px;font-size:12px;" placeholder="0">
                    <span id="condSelSlEur" style="color:#8b949e;font-size:11px;"></span>
                </div>
                <div style="display:flex;align-items:center;gap:4px;">
                    <label style="color:#8b949e;font-size:12px;white-space:nowrap;">SL Book USDT</label>
                    <input id="condSelSlBook" type="number" step="0.01" min="0" style="width:70px;padding:4px 6px;background:#0d1117;border:1px solid #30363d;color:#c9d1d9;border-radius:4px;font-size:12px;" placeholder="0">
                    <span id="condSelSlBookEur" style="color:#8b949e;font-size:11px;"></span>
                </div>
                <button id="btnCondSelActivate" onclick="toggleConditionalSel()" style="background:#238636;color:#fff;border:none;padding:6px 14px;font-size:12px;font-weight:700;cursor:pointer;border-radius:4px;">ACTIVATE</button>
                <span id="condSelStatus" style="font-size:12px;color:#8b949e;"></span>
            </div>
        </div>

        <div style="margin-top:30px;">
            <div class="section-title">Executed Trades <span class="badge" id="closedBadge">0</span></div>
            <div id="closedTable"><div class="empty">No executed trades yet</div></div>
        </div>
    </div>

    <script>
        var prevClosed = -1;
        var eurRate = 0;

        function pn(id) {
            var el = document.getElementById(id);
            if (!el) return 0;
            var v = el.value.replace(/,/g, '.');
            return parseFloat(v) || 0;
        }

        function toEur(usdt) {
            if (!eurRate || eurRate <= 0) return '';
            return ' (' + (usdt / eurRate).toFixed(2) + ' EUR)';
        }

        function playAlert(type) {
            try {
                var ctx = new (window.AudioContext || window.webkitAudioContext)();
                if (type === 'tp') {
                    [800,1000,1200].forEach(function(f,i) {
                        var o=ctx.createOscillator(), g=ctx.createGain();
                        o.connect(g); g.connect(ctx.destination);
                        o.frequency.value=f; o.type='sine'; g.gain.value=0.3;
                        o.start(ctx.currentTime+i*0.15); o.stop(ctx.currentTime+i*0.15+0.12);
                    });
                } else {
                    var o=ctx.createOscillator(), g=ctx.createGain();
                    o.connect(g); g.connect(ctx.destination);
                    o.frequency.value=400; o.type='sawtooth'; g.gain.value=0.25;
                    o.start(ctx.currentTime); o.stop(ctx.currentTime+0.6);
                }
            } catch(e) {}
        }

        function fp(n) { if(!n||n===0) return '--'; if(n>=100)return n.toFixed(2); if(n>=1)return n.toFixed(4); if(n>=0.01)return n.toFixed(6); return n.toFixed(8); }
        function fm(n,d) { if(n===null||n===undefined) return '--'; return Number(n).toFixed(d||2); }

        function showAlert(msg,type) {
            var b=document.getElementById('alertBox');
            b.textContent=msg; b.className='alert-box alert-'+type; b.style.display='block';
            setTimeout(function(){b.style.display='none';},4000);
        }

        function addPosition() {
            var coin = document.getElementById('addCoin').value.trim().toUpperCase();
            var qty = pn('addQty');
            var entry = pn('addEntry');
            if (!coin || !qty || !entry) { showAlert('Fill coin, quantity, and entry price','error'); return; }
            var body = {coin:coin, quantity:qty, entry_price:entry};
            var v;
            v = pn('addTpPct'); if(v>0) body.tp_pct=v;
            v = pn('addSlPct'); if(v>0) body.sl_pct=v;
            v = pn('addTpAmt'); if(v>0) body.tp_amount=v;
            v = pn('addSlAmt'); if(v>0) body.sl_amount=v;
            v = pn('addStopMin'); if(v>0) body.stop_minutes=v;
            fetch('/api/position', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)})
            .then(r=>r.json()).then(d=>{
                if(d.error) showAlert(d.error,'error');
                else { showAlert('Position added: '+coin,'success'); refresh(); }
            });
        }

        function updatePos(pid) {
            var body = {};
            var v;
            v = pn('tp_'+pid); if(v>0) body.tp_pct=v;
            v = pn('sl_'+pid); if(v>0) body.sl_pct=v;
            v = pn('tpa_'+pid); if(v>0) body.tp_amount=v;
            v = pn('sla_'+pid); if(v>0) body.sl_amount=v;
            v = pn('sm_'+pid); if(v>0) body.stop_minutes=v;
            fetch('/api/position/'+pid, {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)})
            .then(r=>r.json()).then(d=>{
                if(d.error) showAlert(d.error,'error');
                else { showAlert('TP/SL updated','success'); refresh(); }
            });
        }

        function closePos(pid) {
            if(!confirm('CLOSE POSITION - This will SELL on Binance at market price. Continue?')) return;
            fetch('/api/position/'+pid+'/close', {method:'POST'})
            .then(r=>r.json()).then(d=>{
                if(d.error) { showAlert(d.error,'error'); return; }
                var c = d.closed;
                var s = c.slippage || {};
                var msg = c.asset+' CLOSED | PnL: '+(c.pnl_pct>=0?'+':'')+fm(c.pnl_pct)+'%';
                msg += ' | USDT: '+(c.pnl_usdt>=0?'+':'')+fm(c.pnl_usdt);
                if(c.pnl_eur!==undefined) msg += ' | EUR: '+(c.pnl_eur>=0?'+':'')+fm(c.pnl_eur);
                if(c.exit_value_eur) msg += ' | Received: '+fm(c.exit_value_eur)+' EUR';
                if(s.best_bid) {
                    msg += ' | Slippage: '+fm(s.slippage_vs_best,4)+'%';
                }
                showAlert(msg, c.pnl_usdt>=0?'success':'error');
                playAlert(c.pnl_usdt>=0?'tp':'sl');
                refresh();
            });
        }

        function removePos(pid) {
            if(!confirm('Remove from tracker only (does NOT sell on Binance). Continue?')) return;
            fetch('/api/position/'+pid, {method:'DELETE'})
            .then(r=>r.json()).then(d=>{ showAlert('Position removed','success'); refresh(); });
        }

        function disablePos(pid) {
            fetch('/api/position/'+pid, {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({enabled:false})})
            .then(r=>r.json()).then(d=>{ showAlert('TP/SL disabled','success'); refresh(); });
        }

        function enablePos(pid) {
            fetch('/api/position/'+pid, {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({enabled:true})})
            .then(r=>r.json()).then(d=>{ showAlert('TP/SL enabled','success'); refresh(); });
        }

        function refresh() {
            fetch('/api/data').then(r=>r.json()).then(function(d) {
                if(d.eur_rate > 0) eurRate = d.eur_rate;

                var badge = document.getElementById('statusBadge');
                var dot = document.getElementById('statusDot');
                var txt = document.getElementById('statusText');
                if(d.ws_connected) { badge.className='status-badge on'; dot.className='dot on'; txt.textContent='Monitoring'; }
                else { badge.className='status-badge off'; dot.className='dot off'; txt.textContent='No positions'; }

                document.getElementById('hPos').textContent = d.total_positions;
                document.getElementById('hInv').textContent = fm(d.total_invested)+' USDT';
                document.getElementById('hVal').textContent = fm(d.total_value)+' USDT';
                var pnlEl = document.getElementById('hPnl');
                pnlEl.textContent = (d.total_pnl>=0?'+':'')+fm(d.total_pnl)+' USDT';
                pnlEl.className = 'value '+(d.total_pnl>=0?'pnl-positive':'pnl-negative');
                document.getElementById('hEur').textContent = eurRate>0 ? 'PnL '+(d.total_pnl>=0?'+':'')+fm(d.total_pnl/eurRate)+' EUR | Val '+fm(d.total_value/eurRate)+' EUR' : '--';

                document.getElementById('cPos').textContent = d.total_positions;
                document.getElementById('cInv').textContent = fm(d.total_invested)+' USDT'+toEur(d.total_invested);
                document.getElementById('cVal').textContent = fm(d.total_value)+' USDT'+toEur(d.total_value);
                var cp = document.getElementById('cPnl');
                cp.textContent = (d.total_pnl>=0?'+':'')+fm(d.total_pnl)+' USDT'+toEur(d.total_pnl);
                cp.className = 'card-value '+(d.total_pnl>=0?'pnl-positive':'pnl-negative');
                var cbp = document.getElementById('cBookPnl');
                cbp.textContent = (d.total_book_pnl>=0?'+':'')+fm(d.total_book_pnl)+' USDT'+toEur(d.total_book_pnl);
                cbp.className = 'card-value '+(d.total_book_pnl>=0?'pnl-positive':'pnl-negative');
                document.getElementById('posBadge').textContent = d.total_positions;

                // EUR conversion for conditional inputs
                if(eurRate > 0) {
                    function showEur(inputId, spanId) {
                        var v = parseFloat(document.getElementById(inputId).value) || 0;
                        document.getElementById(spanId).textContent = v > 0 ? '(' + (v / eurRate).toFixed(2) + ' EUR)' : '';
                    }
                    showEur('condAllTp','condAllTpEur'); showEur('condAllTpBook','condAllTpBookEur');
                    showEur('condAllSl','condAllSlEur'); showEur('condAllSlBook','condAllSlBookEur');
                    showEur('condSelTp','condSelTpEur'); showEur('condSelTpBook','condSelTpBookEur');
                    showEur('condSelSl','condSelSlEur'); showEur('condSelSlBook','condSelSlBookEur');
                }
                // Check conditional triggers
                if(d.conditional_triggered) {
                    d.conditional_triggered.forEach(function(t) {
                        if(t.mode==='sel') {
                            condSelActive=false;
                            document.getElementById('btnCondSelActivate').textContent='ACTIVATE';
                            document.getElementById('btnCondSelActivate').style.background='#238636';
                            document.getElementById('condSelStatus').innerHTML='<span style="color:#3fb950;">TRIGGERED: Closed '+t.closed+' pos ('+t.reason+': '+t.value.toFixed(2)+' USDT)</span>';
                        } else {
                            condAllActive=false;
                            document.getElementById('btnCondAllActivate').textContent='ACTIVATE';
                            document.getElementById('btnCondAllActivate').style.background='#238636';
                            document.getElementById('condAllStatus').innerHTML='<span style="color:#3fb950;">TRIGGERED: Closed '+t.closed+' pos ('+t.reason+': '+t.value.toFixed(2)+' USDT)</span>';
                        }
                    });
                    refresh();
                }

                var div = document.getElementById('posTable');
                var focused = document.activeElement && document.activeElement.closest && document.activeElement.closest('#posTable');
                var checkedIds = {};
                document.querySelectorAll('.selTrade:checked').forEach(function(cb){ checkedIds[cb.dataset.id]=true; });
                var allChecked = document.getElementById('selectAll') && document.getElementById('selectAll').checked;
                if(focused) { /* skip table rebuild while user is editing inputs */ }
                else if(d.positions.length>0) {
                    var h = '<table><tr><th><input type="checkbox" id="selectAll" onchange="toggleAll(this)"></th><th>Coin</th><th>Qty</th><th>Entry</th><th>Current</th><th>Invested</th><th>Value</th><th>PnL</th><th>TP %</th><th>SL %</th><th>TP Amt</th><th>SL Amt</th><th>Min Stop</th><th>TP / SL Price</th><th>Status</th><th></th></tr>';
                    d.positions.forEach(function(p) {
                        var pc = p.pnl_pct>=0?'pnl-positive':'pnl-negative';
                        var sc = p.enabled?'active':'inactive';
                        var st = p.enabled?'ACTIVE':'OFF';
                        var eurInv = eurRate>0 ? '<br><small style="color:#f0883e;">'+fm(p.invested_usdt/eurRate)+' EUR</small>' : '';
                        var eurVal = eurRate>0 ? '<br><small style="color:#f0883e;">'+fm(p.value_usdt/eurRate)+' EUR</small>' : '';
                        var eurPnl = eurRate>0 ? '<br><small class="'+pc+'">'+(p.pnl_usdt>=0?'+':'')+fm(p.pnl_usdt/eurRate)+' EUR</small>' : '';
                        var brc = p.book_real_pnl>=0?'pnl-positive':'pnl-negative';
                        var bookInfo = '';
                        if(p.book_avg>0) {
                            var brEurVal = eurRate>0 ? (p.book_real_pnl>=0?'+':'')+fm(p.book_real_pnl/eurRate) : '';
                            bookInfo = '<br><small class="'+brc+'" style="font-weight:600;">BOOK: '+(p.book_real_pnl_pct>=0?'+':'')+fm(p.book_real_pnl_pct)+'% ('+(p.book_real_pnl>=0?'+':'')+fm(p.book_real_pnl)+' USDT)</small>';
                            if(eurRate>0) bookInfo += '<br><span class="'+brc+'" style="font-size:16px;font-weight:700;">'+brEurVal+' EUR</span>';
                            bookInfo += '<br><small style="color:#8b949e;">Fill: '+fp(p.book_avg)+' | Slip: '+fm(p.book_slippage,3)+'% | '+p.book_levels+' lvl</small>';
                        }
                        h += '<tr>';
                        h += '<td><input type="checkbox" class="selTrade" data-id="'+p.id+'" data-pnl="'+fm(p.pnl_usdt)+'" data-book="'+fm(p.book_real_pnl||p.pnl_usdt)+'" onchange="updateSelection()"></td>';
                        h += '<td><strong>'+p.asset+'</strong></td>';
                        h += '<td>'+fm(p.quantity,4)+'</td>';
                        h += '<td>'+fp(p.entry_price)+'</td>';
                        h += '<td>'+fp(p.current_price)+'</td>';
                        h += '<td>'+fm(p.invested_usdt)+eurInv+'</td>';
                        h += '<td>'+fm(p.value_usdt)+eurVal+'</td>';
                        h += '<td class="'+pc+'" style="white-space:normal;">'+(p.pnl_pct>=0?'+':'')+fm(p.pnl_pct)+'% ('+(p.pnl_usdt>=0?'+':'')+fm(p.pnl_usdt)+' USDT)'+eurPnl+bookInfo+'</td>';
                        h += '<td><input class="tbl" type="text" inputmode="decimal" id="tp_'+p.id+'" value="'+(p.tp_pct?Number(p.tp_pct.toFixed(2)):'')+'"/></td>';
                        h += '<td><input class="tbl" type="text" inputmode="decimal" id="sl_'+p.id+'" value="'+(p.sl_pct?Number(p.sl_pct.toFixed(2)):'')+'"/></td>';
                        h += '<td><input class="tbl" type="text" inputmode="decimal" id="tpa_'+p.id+'" value="'+(p.tp_amount?Number(p.tp_amount.toFixed(2)):'')+'"/></td>';
                        h += '<td><input class="tbl" type="text" inputmode="decimal" id="sla_'+p.id+'" value="'+(p.sl_amount?Number(p.sl_amount.toFixed(2)):'')+'"/></td>';
                        var stopVal = p.stop_minutes||'';
                        var stopInfo = '';
                        if(p.stop_minutes>0 && p.created) {
                            var cr = new Date(p.created+'Z');
                            var now = new Date();
                            var elapsed = (now - cr) / 60000;
                            var remain = Math.max(0, p.stop_minutes - elapsed);
                            if(remain<=0) stopInfo = '<br><small style="color:#f85149;">EXPIRED</small>';
                            else if(remain<60) stopInfo = '<br><small style="color:#f0883e;">'+Math.ceil(remain)+'m left</small>';
                            else stopInfo = '<br><small style="color:#f0883e;">'+Math.floor(remain/60)+'h '+Math.ceil(remain%60)+'m</small>';
                        }
                        h += '<td><input class="tbl" type="text" inputmode="decimal" id="sm_'+p.id+'" value="'+stopVal+'" placeholder="min"/>'+stopInfo+'</td>';
                        h += '<td>'+fp(p.tp_price)+' / '+fp(p.sl_price)+'</td>';
                        h += '<td class="'+sc+'">'+st+'</td>';
                        h += '<td>';
                        h += '<button class="btn btn-danger btn-small" onclick="closePos(\\''+p.id+'\\')">Close</button> ';
                        h += '<button class="btn btn-primary btn-small" onclick="updatePos(\\''+p.id+'\\')">Save</button> ';
                        if(p.enabled) h += '<button class="btn btn-secondary btn-small" onclick="disablePos(\\''+p.id+'\\')">Pause</button> ';
                        else h += '<button class="btn btn-primary btn-small" onclick="enablePos(\\''+p.id+'\\')">Enable</button> ';
                        h += '<button class="btn btn-secondary btn-small" onclick="removePos(\\''+p.id+'\\')">X</button>';
                        h += '</td></tr>';
                    });
                    h += '</table>';
                    div.innerHTML = h;
                    if(allChecked) {
                        var sa=document.getElementById('selectAll'); if(sa) sa.checked=true;
                        document.querySelectorAll('.selTrade').forEach(function(cb){ cb.checked=true; });
                    } else {
                        document.querySelectorAll('.selTrade').forEach(function(cb){ if(checkedIds[cb.dataset.id]) cb.checked=true; });
                    }
                    updateSelection();
                } else {
                    div.innerHTML = '<div class="empty">No positions. Add one above.</div>';
                    var bar=document.getElementById('selectionBar'); if(bar) bar.style.display='none';
                }

                document.getElementById('closedBadge').textContent = d.closed.length;
                var cd = document.getElementById('closedTable');
                if(d.closed.length>0) {
                    if(prevClosed>=0 && d.closed.length>prevClosed) {
                        var last = d.closed[d.closed.length-1];
                        playAlert(last.exit_reason==='TP'?'tp':'sl');
                    }
                    var ch = '<table><tr><th>Time</th><th>Coin</th><th>Entry</th><th>Exit</th><th>Inv USDT</th><th>Inv EUR</th><th>Ret EUR</th><th>PnL USDT</th><th>PnL EUR</th><th>Reason</th></tr>';
                    d.closed.slice().reverse().forEach(function(t) {
                        var tc = t.pnl_pct>=0?'pnl-positive':'pnl-negative';
                        var eurPnl = t.pnl_eur!==undefined ? (t.pnl_eur>=0?'+':'')+fm(t.pnl_eur)+' EUR' : (eurRate>0 ? (t.pnl_usdt>=0?'+':'')+fm(t.pnl_usdt/eurRate)+' EUR' : '--');
                        ch += '<tr><td>'+t.exit_time+'</td><td><strong>'+t.asset+'</strong></td>';
                        ch += '<td>'+fp(t.entry_price)+'</td><td>'+fp(t.exit_price)+'</td>';
                        ch += '<td>'+fm(t.invested_usdt)+'</td>';
                        ch += '<td>'+(t.invested_eur?fm(t.invested_eur):'--')+'</td>';
                        ch += '<td class="'+tc+'">'+(t.exit_value_eur?fm(t.exit_value_eur):'--')+'</td>';
                        ch += '<td class="'+tc+'">'+(t.pnl_pct>=0?'+':'')+fm(t.pnl_pct)+'% ('+(t.pnl_usdt>=0?'+':'')+fm(t.pnl_usdt)+')</td>';
                        ch += '<td class="'+tc+'">'+eurPnl+'</td>';
                        ch += '<td>'+t.exit_reason+'</td></tr>';
                    });
                    ch += '</table>';
                    cd.innerHTML = ch;
                } else {
                    cd.innerHTML = '<div class="empty">No executed trades yet</div>';
                }
                prevClosed = d.closed.length;
            });
        }

        document.getElementById('btnAddPosition').addEventListener('click', function() { addPosition(); });

        document.getElementById('btnCloseAll').addEventListener('click', function() {
            if(!confirm('CLOSE ALL POSITIONS - This will SELL ALL on Binance at market price. Are you sure?')) return;
            fetch('/api/close-all', {method:'POST'})
            .then(r=>r.json()).then(d=>{
                if(d.error) showAlert(d.error,'error');
                else { showAlert('ALL positions closed - '+d.closed+' sold on Binance','success'); playAlert('sl'); refresh(); }
            });
        });

        function getInvested() {
            return pn('addQty') * pn('addEntry');
        }

        function calcEntryAndAmounts() {
            var inv = getInvested();
            var tp = pn('addTpPct'), sl = pn('addSlPct');
            if (inv > 0 && tp > 0) document.getElementById('addTpAmt').value = (inv * tp / 100).toFixed(2);
            if (inv > 0 && sl > 0) document.getElementById('addSlAmt').value = (inv * sl / 100).toFixed(2);
        }

        document.getElementById('addTotalEur').addEventListener('input', function() {
            var totalEur = pn('addTotalEur');
            var qty = pn('addQty');
            if (totalEur > 0 && eurRate > 0) {
                var totalUsdt = totalEur * eurRate;
                document.getElementById('addTotalUsdt').value = totalUsdt.toFixed(2);
                if (qty > 0) {
                    document.getElementById('addEntry').value = (totalUsdt / qty).toFixed(8);
                    calcEntryAndAmounts();
                }
            }
        });

        document.getElementById('addTotalUsdt').addEventListener('input', function() {
            var totalUsdt = pn('addTotalUsdt');
            var qty = pn('addQty');
            if (totalUsdt > 0 && eurRate > 0) {
                document.getElementById('addTotalEur').value = (totalUsdt / eurRate).toFixed(2);
            }
            if (totalUsdt > 0 && qty > 0) {
                document.getElementById('addEntry').value = (totalUsdt / qty).toFixed(8);
                calcEntryAndAmounts();
            }
        });

        document.getElementById('addTpPct').addEventListener('input', function() {
            var inv = getInvested();
            if (inv > 0) document.getElementById('addTpAmt').value = (inv * pn('addTpPct') / 100).toFixed(2);
        });
        document.getElementById('addSlPct').addEventListener('input', function() {
            var inv = getInvested();
            if (inv > 0) document.getElementById('addSlAmt').value = (inv * pn('addSlPct') / 100).toFixed(2);
        });
        document.getElementById('addTpAmt').addEventListener('input', function() {
            var inv = getInvested();
            if (inv > 0) document.getElementById('addTpPct').value = (pn('addTpAmt') / inv * 100).toFixed(1);
        });
        document.getElementById('addSlAmt').addEventListener('input', function() {
            var inv = getInvested();
            if (inv > 0) document.getElementById('addSlPct').value = (pn('addSlAmt') / inv * 100).toFixed(1);
        });
        document.getElementById('addQty').addEventListener('input', function() {
            var qty = pn('addQty');
            var totalEur = pn('addTotalEur');
            var totalUsdt = pn('addTotalUsdt');
            if (totalEur > 0 && eurRate > 0 && qty > 0) {
                totalUsdt = totalEur * eurRate;
                document.getElementById('addTotalUsdt').value = totalUsdt.toFixed(2);
                document.getElementById('addEntry').value = (totalUsdt / qty).toFixed(8);
            } else if (totalUsdt > 0 && qty > 0) {
                document.getElementById('addEntry').value = (totalUsdt / qty).toFixed(8);
            }
            calcEntryAndAmounts();
        });
        document.getElementById('addEntry').addEventListener('input', function() {
            calcEntryAndAmounts();
        });

        function toggleAll(el) {
            document.querySelectorAll('.selTrade').forEach(function(cb){ cb.checked=el.checked; });
            updateSelection();
        }
        function updateSelection() {
            var checks=document.querySelectorAll('.selTrade:checked');
