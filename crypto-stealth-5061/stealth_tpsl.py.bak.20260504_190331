def main():
    config_path = os.path.join(DATA_DIR, "config.json")
    with open(config_path) as f:
        config = json.load(f)

    port = config.get("dashboard", {}).get("port", 5061)
    app = create_app(config)

    logger.info(f"Starting Stealth TP/SL Manager on port {port}")
    logger.info("NO Binance API used for monitoring - only public WebSocket")
    logger.info("API key only used when executing sell orders")
    app.run(host="0.0.0.0", port=port, debug=False)


if __name__ == "__main__":
    main()
